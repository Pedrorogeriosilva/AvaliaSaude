# Supabase - obrigatório para rodar o sistema
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Obrigatório somente para criar usuários pelo próprio site em Cadastros > Usuários.
# Configure apenas no servidor/Vercel. Nunca use esta chave em código frontend.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY

# Senha adicional exigida para abrir e administrar Cadastros > Usuários.
# Configure apenas no servidor/Vercel. Nunca exponha essa senha no frontend.
ADMIN_CREATION_PASSWORD=DEFINA_A_SENHA_EXTRA_AQUI

# Recomendado: secret independente para assinar o gate temporário da área de usuários.
# Não reutilize tokens do Supabase nem publique este valor.
ADMIN_GATE_SECRET=DEFINA_UM_SECRET_FORTE_E_ALEATORIO_AQUI

# Opcional: usado apenas pelo comando npm run setup:admin
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=DEFINA_UMA_SENHA_FORTE_AQUI
ADMIN_NAME=Administrador Avalia Saúde
